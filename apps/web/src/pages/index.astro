---
import { ApiStatus } from "../components/ApiStatus";

const title = "Primer Parcial";
const apiOrigin = import.meta.env.PUBLIC_API_ORIGIN;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <ApiStatus client:load apiOrigin={apiOrigin} />
    </main>
  </body>
</html>
