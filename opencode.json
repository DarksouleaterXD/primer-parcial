{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/PROJECT_CONTEXT.md",
    "docs/STATUS.md",
    "docs/puds/use-cases/CU-0-inicializar-base.md"
  ],
  "share": "disabled",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow",
      "*\\.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow",
      "*\\.env.example": "allow"
    },
    "glob": "allow",
    "grep": "ask",
    "list": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git branch --show-current": "allow",
      "git --version": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "docker --version": "allow",
      "docker compose version": "allow",
      "*&&*": "ask",
      "*||*": "ask",
      "*;*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*$*": "ask",
      "*`*": "ask",
      "*\n*": "ask",
      "*git *add*": "deny",
      "*git *commit*": "deny",
      "*git *push*": "deny",
      "*git *reset*": "deny",
      "*git *clean*": "deny",
      "*gh *repo *create*": "deny",
      "*gh *api*": "deny",
      "*--output*": "deny",
      "*--ext-diff*": "deny",
      "*--textconv*": "deny",
      "*.env*": "deny",
      "rm *": "deny",
      "* rm *": "deny",
      "rmdir *": "deny",
      "* rmdir *": "deny",
      "rd *": "deny",
      "* rd *": "deny",
      "Remove-Item*": "deny",
      "*Remove-Item*": "deny",
      "remove-item*": "deny",
      "*remove-item*": "deny",
      "ri *": "deny",
      "* ri *": "deny",
      "del *": "deny",
      "* del *": "deny"
    }
  }
}
